# The component-test conformance harness: builders produce artifacts,
# runners execute prebuilt artifacts, the aggregate joins result
# streams against the committed lockfile and targets.toml and diffs
# the committed matrix.

import '../../justfile.shared.just'

# Hard cap on any single leg, so a wedged run cannot hang a CI job to
# its timeout. Empty where GNU coreutils' `timeout` is missing (macOS):
# the caps only bound CI-shaped environments.
timeout_cmd := `command -v timeout >/dev/null 2>&1 && echo "timeout 600" || echo ""`

ct_cli := root / "target/ct-tools/bin/component-test"
suite_wasm := root / "target/wasm32-wasip2/release/conformance_guest_ct.wasm"
results := root / "conformance/driver-ct/results"

default: all

# Build + lockfile gate + run every leg + aggregate + matrix gate.
all: build lock-check run-wasmtime run-jco-node run-jco-browser run-composed aggregate matrix-check

# ----- builders ---------------------------------------------------------------

build-suite:
    cargo build --manifest-path {{root}}/Cargo.toml \
        --target wasm32-wasip2 --release -p conformance-guest-ct

build-driver:
    cargo build --manifest-path {{root}}/Cargo.toml -p conformance-ct-driver

# The component-test CLI, installed from the same git rev Cargo.lock
# pins for the library crates (the lock is the single source of truth;
# same-rev reruns are a no-op "already installed"). No --locked:
# component-test does not commit a Cargo.lock.
_ct-tools:
    #!/usr/bin/env bash
    set -euo pipefail
    rev="$(grep -om1 'component-test?rev=[0-9a-f]*' '{{root}}/Cargo.lock' | cut -d= -f2)"
    cargo install --git https://github.com/polymorph-components/polymorph-test --rev "$rev" \
        component-test-cli --root '{{root}}/target/ct-tools'

build-echod:
    cargo build --manifest-path {{root}}/Cargo.toml -p conformance-echod

# The in-guest provider (wasm32-wasip2 emits a component directly).
build-provider:
    cargo build --manifest-path {{root}}/Cargo.toml --release -p websocket-guest-provider --target wasm32-wasip2

# The polymorph:tls component, cloned lazily at the rev pinned by
# rust/guest-provider/tls-component.rev and built from source (the
# project publishes no artifacts yet). The checkout lives under target/
# (build territory).
build-tls-component:
    #!/usr/bin/env bash
    set -euo pipefail
    rev="$(cat {{root}}/rust/guest-provider/tls-component.rev)"
    dir={{root}}/target/deps/component-tls
    if [ ! -d "$dir/.git" ]; then
        mkdir -p "$(dirname "$dir")"
        git clone https://github.com/polymorph-components/polymorph-tls "$dir"
    fi
    if [ "$(git -C "$dir" rev-parse HEAD)" != "$rev" ]; then
        git -C "$dir" fetch origin "$rev"
        git -C "$dir" checkout --detach "$rev"
    fi
    cd "$dir"
    cargo build --release --target wasm32-wasip2 -p polymorph-tls-component

# The composed leg's component: the suite with its polymorph:websocket import
# plugged by the provider (which carries the TLS component for wss:).
# The composed artifact keeps the suite's file stem (the results
# envelope names the suite after it; the lockfile must agree) in its own
# directory.
compose-suite: build-suite build-provider build-tls-component
    mkdir -p {{root}}/target/wasm32-wasip2/release/composed
    wac plug --plug {{root}}/target/deps/component-tls/target/wasm32-wasip2/release/polymorph_tls_component.wasm \
        {{root}}/target/wasm32-wasip2/release/websocket_guest_provider.wasm \
        -o {{root}}/target/wasm32-wasip2/release/composed/websocket-guest-provider-tls.wasm
    wac plug --plug {{root}}/target/wasm32-wasip2/release/composed/websocket-guest-provider-tls.wasm \
        {{suite_wasm}} \
        -o {{root}}/target/wasm32-wasip2/release/composed/conformance_guest_ct.wasm

# pnpm install + transpile (the echo/text-unicode case guards the
# transpiler's string lowering).
_jco-prepared: build-suite build-echod
    pnpm --dir {{root}}/conformance/driver-ct/jco install --silent
    pnpm --dir {{root}}/conformance/driver-ct/jco run transpile

build: build-suite build-driver build-echod _ct-tools _jco-prepared

# ----- lockfile ---------------------------------------------------------------

# The committed inventory is the corpus mirror (replacing the incumbent
# four-way mirror): drift fails here and in the runner's cross-check.
lock-check: build-suite _ct-tools
    {{ct_cli}} lock {{suite_wasm}} \
        --check {{root}}/conformance/guest-ct/tests.lock

# Regenerate after suite changes; commit the diff (the review surface).
lock-update: build-suite _ct-tools
    {{ct_cli}} lock {{suite_wasm}} \
        -o {{root}}/conformance/guest-ct/tests.lock

# ----- runners ----------------------------------------------------------------

run-wasmtime: build-suite build-driver
    mkdir -p {{results}}
    {{timeout_cmd}} {{root}}/target/debug/ct-driver {{suite_wasm}} \
        --jsonl --jobs 4 --target wasmtime > {{results}}/wasmtime.jsonl

run-jco-node: _jco-prepared
    # NODE_EXTRA_CA_CERTS provisions trust for the suite's committed test
    # PKI; Node reads it at process startup, so it rides the recipe.
    NODE_EXTRA_CA_CERTS={{root}}/conformance/server/tls/ca.pem {{timeout_cmd}} pnpm --dir {{root}}/conformance/driver-ct/jco run run:node

run-composed: compose-suite build-driver build-echod
    {{timeout_cmd}} {{root}}/target/debug/ct-driver \
        {{root}}/target/wasm32-wasip2/release/composed/conformance_guest_ct.wasm \
        --composed --suite-artifact {{suite_wasm}} \
        --jsonl --jobs 4 --target composed > {{results}}/composed.jsonl

run-jco-browser: _jco-prepared
    {{timeout_cmd}} pnpm --dir {{root}}/conformance/driver-ct/jco run run:browser

# ----- aggregation -------------------------------------------------------------

aggregate: _ct-tools
    {{ct_cli}} aggregate \
        --lock {{root}}/conformance/guest-ct/tests.lock \
        --manifest {{root}}/conformance/driver-ct/targets.toml \
        --results wasmtime={{results}}/wasmtime.jsonl \
        --results composed={{results}}/composed.jsonl \
        --results jco-node={{results}}/jco-node.jsonl \
        --results jco-browser={{results}}/jco-browser.jsonl \
        -o {{results}}/matrix.md

# The committed matrix is the cross-target review surface; regenerate
# with matrix-update and commit the diff.
matrix-check:
    diff -u {{root}}/conformance/driver-ct/matrix.md {{results}}/matrix.md

matrix-update:
    cp {{results}}/matrix.md {{root}}/conformance/driver-ct/matrix.md
