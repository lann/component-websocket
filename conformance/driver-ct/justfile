# The component-test conformance harness (migration in progress: all
# three legs run here; the incumbent harness in ../justfile stays
# authoritative until the cutover).
#
# Builders produce artifacts, runners execute prebuilt artifacts, the
# aggregate joins result streams against the committed lockfile and
# targets.toml and diffs the committed matrix.

import '../../justfile.shared.just'

ct := root / "../component-test"
ct_cli := ct / "target/debug/component-test"
suite_wasm := root / "target/wasm32-wasip2/release/conformance_guest_ct.wasm"
results := root / "conformance/driver-ct/results"

default: all

# Build + lockfile gate + run every leg + aggregate + matrix gate.
all: build lock-check run-wasmtime run-jco-node run-jco-browser aggregate matrix-check

# ----- builders ---------------------------------------------------------------

build-suite:
    cargo build --manifest-path {{root}}/Cargo.toml \
        --target wasm32-wasip2 --release -p conformance-guest-ct

build-driver:
    cargo build --manifest-path {{root}}/Cargo.toml -p conformance-ct-driver

# The component-test CLI from the sibling checkout (see
# .component-test-rev; scripts/setup.sh provisions the checkout).
_ct-tools:
    cargo build --manifest-path {{ct}}/Cargo.toml -p component-test-cli

build-echod:
    cargo build --manifest-path {{root}}/Cargo.toml -p conformance-echod

# npm install + transpile (includes the jco string-lowering patch; the
# echo/text-unicode case guards it).
_jco-prepared: build-suite build-echod
    npm --prefix {{root}}/conformance/driver-ct/jco install --silent
    npm --prefix {{root}}/conformance/driver-ct/jco run transpile

build: build-suite build-driver build-echod _ct-tools _jco-prepared

# ----- lockfile ---------------------------------------------------------------

# The committed inventory is the corpus mirror (replacing the incumbent
# four-way mirror): drift fails here and in the runner's cross-check.
lock-check: build-suite _ct-tools
    {{ct_cli}} lock {{suite_wasm}} \
        --check {{root}}/conformance/guest-ct/tests.lock

# Regenerate after suite changes; commit the diff (the review surface).
lock-update: build-suite _ct-tools
    {{ct_cli}} lock {{suite_wasm}} \
        -o {{root}}/conformance/guest-ct/tests.lock

# ----- runners ----------------------------------------------------------------

run-wasmtime: build-suite build-driver
    mkdir -p {{results}}
    {{root}}/target/debug/ct-driver {{suite_wasm}} \
        --jsonl --jobs 4 --target wasmtime > {{results}}/wasmtime.jsonl

run-jco-node: _jco-prepared
    npm --prefix {{root}}/conformance/driver-ct/jco run run:node

run-jco-browser: _jco-prepared
    npm --prefix {{root}}/conformance/driver-ct/jco run run:browser

# ----- aggregation -------------------------------------------------------------

aggregate: _ct-tools
    {{ct_cli}} aggregate \
        --lock {{root}}/conformance/guest-ct/tests.lock \
        --manifest {{root}}/conformance/driver-ct/targets.toml \
        --results wasmtime={{results}}/wasmtime.jsonl \
        --results jco-node={{results}}/jco-node.jsonl \
        --results jco-browser={{results}}/jco-browser.jsonl \
        -o {{results}}/matrix.md

# The committed matrix is the cross-target review surface; regenerate
# with matrix-update and commit the diff.
matrix-check:
    diff -u {{root}}/conformance/driver-ct/matrix.md {{results}}/matrix.md

matrix-update:
    cp {{results}}/matrix.md {{root}}/conformance/driver-ct/matrix.md
