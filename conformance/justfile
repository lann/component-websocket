# The conformance suite: builders produce artifacts, runners execute
# prebuilt artifacts only. The split keeps per-target iteration cheap
# (`just conformance::wasmtime` rebuilds only what its target needs) and
# leaves a build-once/fan-out CI shape available if the matrix grows.

import '../justfile.shared.just'

# Hard cap on any single adapter invocation, so a wedged run cannot hang a
# CI job to its timeout. Empty where GNU coreutils' `timeout` is missing
# (macOS): the caps only bound CI-shaped environments.
timeout_cmd := `command -v timeout >/dev/null 2>&1 && echo "timeout 600" || echo ""`

default: all

# Clean stale results, build everything, run every target, classify.
all: _clean-results build-all run-wasmtime run-jco-node run-jco-browser classify

# ----- builders ---------------------------------------------------------------

build-guest: (build-component "conformance-guest")

# Transpile the guest for the jco adapters (includes the string-lowering
# patch; see scripts/patch-jco-string-lowering.mjs).
transpile-guest: build-guest
    npm --prefix {{root}}/conformance/adapters/jco run transpile

build-echod:
    cargo build -p conformance-echod

build-adapter-wasmtime:
    cargo build -p conformance-adapter-wasmtime

build-runner:
    cargo build -p conformance-runner

build-all: build-guest transpile-guest build-echod build-adapter-wasmtime build-runner

# ----- runners ----------------------------------------------------------------

# Stale results must never classify as current; a stale matrix must not
# outlive the run that would replace it.
[private]
_clean-results:
    rm -f {{root}}/conformance/results/*.json {{root}}/conformance/matrix.md

run-wasmtime:
    {{timeout_cmd}} {{root}}/target/debug/conformance-adapter-wasmtime \
        --guest {{root}}/target/components/conformance-guest.wasm \
        --tests {{root}}/conformance/tests.toml \
        --out {{root}}/conformance/results

run-jco-node:
    # NODE_EXTRA_CA_CERTS provisions trust for the suite's committed test
    # PKI; Node reads it at process startup, so it rides the recipe.
    NODE_EXTRA_CA_CERTS={{root}}/conformance/server/tls/ca.pem {{timeout_cmd}} npm --prefix {{root}}/conformance/adapters/jco run run:node

run-jco-browser:
    {{timeout_cmd}} npm --prefix {{root}}/conformance/adapters/jco run run:browser

# Classify the collected results against tests.toml and targets.toml and
# render the matrix. Completeness is required: every declared target must
# have reported every registered test from one guest build. Exits nonzero
# on any failing cell.
classify:
    {{root}}/target/debug/conformance-runner \
        --tests {{root}}/conformance/tests.toml \
        --targets {{root}}/conformance/targets.toml \
        --results {{root}}/conformance/results \
        --require-complete \
        --matrix-out {{root}}/conformance/matrix.md

# Classify whatever results exist (for `--only`/single-target iteration);
# incompleteness warns instead of failing.
classify-partial:
    {{root}}/target/debug/conformance-runner \
        --tests {{root}}/conformance/tests.toml \
        --targets {{root}}/conformance/targets.toml \
        --results {{root}}/conformance/results \
        --matrix-out {{root}}/conformance/matrix.md

# ----- per-target conveniences -------------------------------------------------

wasmtime: build-guest build-adapter-wasmtime build-runner run-wasmtime
jco-node: transpile-guest build-echod build-runner run-jco-node
jco-browser: transpile-guest build-echod build-runner run-jco-browser

# Run selected tests against one target, then classify leniently:
# `just conformance::only wasmtime close-local echo-binary`.
only target +tests: build-all
    #!/usr/bin/env bash
    set -euo pipefail
    flags=()
    for t in {{tests}}; do flags+=(--only "$t"); done
    case "{{target}}" in
        wasmtime)
            {{root}}/target/debug/conformance-adapter-wasmtime \
                --guest {{root}}/target/components/conformance-guest.wasm \
                --tests {{root}}/conformance/tests.toml \
                --out {{root}}/conformance/results "${flags[@]}" ;;
        jco-node)
            npm --prefix {{root}}/conformance/adapters/jco run run:node -- "${flags[@]}" ;;
        jco-browser)
            npm --prefix {{root}}/conformance/adapters/jco run run:browser -- "${flags[@]}" ;;
        *)
            echo "unknown target {{target}} (wasmtime | jco-node | jco-browser)" >&2
            exit 1 ;;
    esac
    just conformance::classify-partial
